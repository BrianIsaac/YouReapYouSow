# YouReapYouSow settings. Copy to .env and fill in only what you use; never commit .env.
# An empty value below means "unset": the default named beside it applies.

# Reap backend: mock (default), sandbox or kwal
REAP_BACKEND=
# The Reap sandbox key; required for REAP_BACKEND=sandbox
REAP_API_KEY=
# Default https://sg.sandbox.api.reap.global
REAP_BASE_URL=
# The operator's ACTIVE agentic enrolment on the sandbox (a UUID)
REAP_ENROLLMENT_ID=
# The purchase file in force; default configs/purchase-prize.yaml
PURCHASE_CONFIG=
# Kwal session file when not at ~/.config/pws/agent-payment/credentials.json
PWS_CREDENTIALS_FILE=

# Models: openai (default when OPENAI_API_KEY is set) or featherless
MODEL_PROVIDER=
OPENAI_API_KEY=
FEATHERLESS_API_KEY=

# Demo time: real seconds per challenge day; 8.571 makes a minute stand for a week
DEMO_CLOCK=
